# Copia este archivo a .env y rellena los valores.

# OCR del diario (Claude vision)
ANTHROPIC_API_KEY=

# Supabase — Postgres (Connection string / Pooler). Para migraciones y queries SSR.
# Project -> Connect -> ORMs / Connection string. Es SECRETO (lleva password).
DATABASE_URL=

# Supabase Auth/Storage (más adelante: login + media). Project Settings -> API.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Editor (login). EDITOR_PASSWORD = tu contraseña; SESSION_SECRET = string aleatorio largo.
EDITOR_PASSWORD=
SESSION_SECRET=
