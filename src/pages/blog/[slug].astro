---
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import { getEntry } from '../../lib/db.js';

const { slug } = Astro.params;
const entry = await getEntry('blog', slug);
if (!entry) return new Response(null, { status: 404 });

const contentHtml = await marked.parse(entry.body ?? '');
const dateStr = new Date(entry.date).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={entry.title}>
  <article class="post">
    <a class="back" href="/">← volver</a>
    <h1>{entry.title}</h1>
    <time>{dateStr}</time>
    <div class="prose" set:html={contentHtml}></div>
  </article>
</Base>

<style>
  .post {
    max-width: 680px;
    margin: 0 auto;
    padding: clamp(32px, 8vh, 80px) 20px;
    line-height: 1.7;
  }
  .back { font-size: 13px; }
  h1 {
    margin: 24px 0 4px;
    color: var(--amber);
    letter-spacing: 0.04em;
  }
  time { color: var(--muted); font-size: 13px; }
  .prose { margin-top: 28px; }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(h2) { margin: 32px 0 12px; color: #e6dcc8; }
  .prose :global(a) { text-decoration: underline; }
  .prose :global(code) {
    background: #1a1510;
    padding: 1px 6px;
    border-radius: 3px;
  }
</style>
