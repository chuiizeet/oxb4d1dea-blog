---
import Base from '../layouts/Base.astro';
import LoginDesktop from '../components/LoginDesktop.svelte';
import { checkPassword, createSession, verifySession, COOKIE, MAX_AGE } from '../lib/auth.js';

// si ya hay sesión válida, no mostrar el login otra vez -> directo al panel
if (verifySession(Astro.cookies.get(COOKIE)?.value)) {
  return Astro.redirect('/panel');
}

// fallback sin JS: POST clásico a esta misma página
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const pw = form.get('password')?.toString() ?? '';
  if (checkPassword(pw)) {
    Astro.cookies.set(COOKIE, createSession(), {
      httpOnly: true,
      sameSite: 'lax',
      path: '/',
      maxAge: MAX_AGE,
      secure: import.meta.env.PROD,
    });
    return Astro.redirect('/panel');
  }
  error = 'Contraseña incorrecta.';
}
---

<Base title="Umbrella OS — Acceso" fullbleed>
  <LoginDesktop client:load />
  <noscript>
    <form method="POST" class="nojs">
      <h1>ACCESO</h1>
      <input type="password" name="password" placeholder="contraseña" autofocus />
      {error && <p class="err">{error}</p>}
      <button type="submit">ENTRAR</button>
    </form>
  </noscript>
</Base>

<style>
  /* solo visible sin JS; cubre el escritorio vacío */
  .nojs {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; flex-direction: column; gap: 12px;
    align-items: center; justify-content: center;
    background: #0a6b62; padding: 20px;
    font-family: ui-monospace, monospace; color: #d9f5e3;
  }
  .nojs h1 { color: #5bff8f; letter-spacing: 0.2em; }
  .nojs input { padding: 10px; background: #05100a; border: 1px solid #2c7a4d; color: #d9f5e3; }
  .nojs button { padding: 10px 18px; background: transparent; border: 1px solid #2c7a4d; color: #9dffc1; cursor: pointer; }
  .nojs .err { color: #ff6a5a; }
</style>
