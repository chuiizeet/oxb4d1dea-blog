---
import Base from '../../layouts/Base.astro';
import ReFileViewer from '../../components/ReFileViewer.svelte';
import { diarioImage } from '../../lib/diario.js';
import { renderMarkdown } from '../../lib/markdown.js';
import { getEntry, getEntriesByType } from '../../lib/db.js';

const { slug } = Astro.params;
const entry = await getEntry('diario', slug);
if (!entry) return new Response(null, { status: 404 });

// número de archivo = posición por fecha ascendente
const all = await getEntriesByType('diario');
const asc = [...all].sort(
  (a, b) =>
    new Date(a.date).valueOf() - new Date(b.date).valueOf() ||
    new Date(a.created_at).valueOf() - new Date(b.created_at).valueOf()
);
const num = String(asc.findIndex((e) => e.slug === slug) + 1).padStart(2, '0');

const html = renderMarkdown(entry.body ?? '');
const pages = html
  .split(/<hr\s*\/?>/i)
  .map((s) => s.trim())
  .filter(Boolean);
const image = diarioImage(entry);
const attachments = Array.isArray(entry.attachments) ? entry.attachments : [];
// "editado" sólo si se modificó bastante después de crearse (>90s)
const createdMs = entry.created_at ? new Date(entry.created_at).getTime() : 0;
const updatedMs = entry.updated_at ? new Date(entry.updated_at).getTime() : 0;
const editedAt = updatedMs - createdMs > 90000 ? new Date(entry.updated_at).toISOString() : null;
const dateStr = new Date(entry.date).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={entry.title} fullbleed>
  <ReFileViewer client:load image={image} pages={pages} title={entry.title} num={num} date={dateStr} attachments={attachments} editedAt={editedAt} />
</Base>
