---
import Base from '../layouts/Base.astro';
import PauseMenu from '../components/PauseMenu.svelte';
import { getEntries, getProfile, getInventory } from '../lib/db.js';
import { diarioImage } from '../lib/diario.js';
import { moodToCondition, moodColor } from '../lib/conditions.js';

const all = await getEntries(); // ambos tipos, ordenado por date desc
const profile = await getProfile();
const slots = await getInventory();

const fmt = (d) =>
  new Date(d).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
const monthFmt = (d) => {
  const dt = new Date(d);
  return `${dt.toLocaleDateString('es-ES', { month: 'long', timeZone: 'UTC' })} ${dt.getUTCFullYear()}`;
};
// "última actualización": fecha + hora en hora local (CDMX)
const updFmt = (d) =>
  new Date(d).toLocaleString('es-ES', {
    day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit',
    hour12: false, timeZone: 'America/Mexico_City',
  });
const excerpt = (md = '') => {
  const clean = (md || '')
    .replace(/^[ \t]*@fecha:.*$/gim, '')        // marcadores de fecha
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')        // imágenes markdown
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')     // links -> texto
    .replace(/<[^>]+>/g, '')                     // html (video, etc.)
    .replace(/^[ \t]*[-*+]\s+/gm, '')            // viñetas
    .replace(/[#>*_`~]/g, '')                    // símbolos markdown
    .replace(/-{3,}/g, ' ')                      // --- (saltos de página)
    .replace(/\s+/g, ' ')
    .trim();
  return clean.length > 280 ? clean.slice(0, 280).trimEnd() + '…' : clean;
};

// estado del menú: fijo (elegido en el perfil) o automático (último diario)
const latestDiario = all.find((e) => e.type === 'diario');
const condition =
  profile.status && profile.status !== 'auto'
    ? profile.status
    : moodToCondition(latestDiario?.mood);

const entries = all.map((e) =>
  e.type === 'diario'
    ? {
        type: 'diario',
        title: e.title,
        date: new Date(e.date).toISOString(),
        dateLabel: fmt(e.date),
        monthLabel: monthFmt(e.updated_at),
        updatedAt: new Date(e.updated_at).toISOString(),
        updatedLabel: updFmt(e.updated_at),
        summary: excerpt(e.body),
        image: diarioImage(e),
        mood: e.mood ?? '',
        moodColor: moodColor(e.mood),
        href: `/diario/${e.slug}`,
      }
    : {
        type: 'blog',
        title: e.title,
        date: new Date(e.date).toISOString(),
        dateLabel: fmt(e.date),
        monthLabel: monthFmt(e.updated_at),
        updatedAt: new Date(e.updated_at).toISOString(),
        updatedLabel: updFmt(e.updated_at),
        summary: e.summary ?? excerpt(e.body),
        image: '',
        href: `/blog/${e.slug}`,
      }
);

// la lista se ordena por última actualización (lo más reciente, arriba)
entries.sort((a, b) => (a.updatedAt < b.updatedAt ? 1 : a.updatedAt > b.updatedAt ? -1 : 0));

// secciones del header (con su propio historial) vs rejilla de items
const equipSec = slots.find((s) => s.slot === 'equip');
const discSec = slots.find((s) => s.slot === 'disc');
const equip = { art: equipSec?.cover || '', title: equipSec?.title || '', url: equipSec?.url || '' };
const item = { title: discSec?.title || '', cover: discSec?.cover || '', url: discSec?.url || '' };
const inventory = slots
  .filter((s) => (s.slot ?? 'grid') === 'grid')
  .map((s) => ({
    label: s.title || s.label, // si la sección no tiene item actual, muestra su nombre
    sub: s.sub || '',
    desc: s.description || '',
    cover: s.cover || '',
    url: s.url || '',
    icon: s.icon || '',
  }));
---

<Base title="0xb4d1dea">
  <PauseMenu
    client:load
    name={profile.name}
    avatar={profile.avatar}
    entries={entries}
    condition={condition}
    equip={equip}
    item={item}
    inventory={inventory}
  />
</Base>
