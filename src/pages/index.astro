---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PauseMenu from '../components/PauseMenu.svelte';

const diario = await getCollection('diario');
const blog = await getCollection('blog');

// El "estado" del menú = el mood de la última entrada del diario.
const latestDiario = [...diario].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)[0];
const MOOD_ALIAS = {
  sad: 'sadness', triste: 'sadness',
  tired: 'tired', cansado: 'tired',
  calm: 'calm', tranquilo: 'calm', calmado: 'calm',
  fine: 'fine', bien: 'fine',
  hyped: 'hyped', feliz: 'hyped', emocionado: 'hyped',
  poison: 'poison', enfermo: 'poison',
  caution: 'caution', alerta: 'caution',
  danger: 'danger', mal: 'danger',
};
const rawMood = (latestDiario?.data.mood ?? 'fine').toLowerCase().trim();
const condition = MOOD_ALIAS[rawMood] ?? rawMood;

// EQUIP = pixel art (sprite/objeto que te representa).
const equip = { art: '' }; // ej: /equip.png en public/
// ITEM = el disco que te tiene marcado ahora.
const item = {
  title: '',
  artist: '',
  cover: '', // ej: /album.jpg en public/
  url: '', // link de Spotify/Apple/YouTube
};

// INVENTARIO = tus cosas del momento (máx 8). Cada item:
// { label, sub, cover, url, icon }. cover = imagen en public/.
const inventory = [
  { label: 'Libro actual', sub: '(autor)', cover: '', url: '', icon: '📖' },
  { label: 'Álbum del momento', sub: '(artista)', cover: '', url: '', icon: '💿' },
  { label: 'Jugando', sub: '(juego)', cover: '', url: '', icon: '🎮' },
];

const fmt = (d) =>
  d.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });

const excerpt = (md = '') =>
  md.replace(/[#>*_`\-]/g, '').replace(/\s+/g, ' ').trim().slice(0, 110);

const entries = [
  ...diario.map((e) => ({
    type: 'diario',
    title: e.data.title,
    date: e.data.date.toISOString(),
    dateLabel: fmt(e.data.date),
    summary: excerpt(e.body),
    image: e.data.image ?? '',
    href: `/diario/${e.id}`,
  })),
  ...blog.map((e) => ({
    type: 'blog',
    title: e.data.title,
    date: e.data.date.toISOString(),
    dateLabel: fmt(e.data.date),
    summary: e.data.summary ?? excerpt(e.body),
    image: '',
    href: `/blog/${e.id}`,
  })),
].sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());
---

<Base title="0xb4d1dea">
  <PauseMenu client:load entries={entries} condition={condition} equip={equip} item={item} inventory={inventory} />
</Base>
