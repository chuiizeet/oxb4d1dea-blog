---
import Base from '../layouts/Base.astro';
import PauseMenu from '../components/PauseMenu.svelte';
import { getEntries, getProfile } from '../lib/db.js';
import { diarioImage } from '../lib/diario.js';
import { moodToCondition, moodColor } from '../lib/conditions.js';

const all = await getEntries(); // ambos tipos, ordenado por date desc
const profile = await getProfile();

const fmt = (d) =>
  new Date(d).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
const monthFmt = (d) => {
  const dt = new Date(d);
  return `${dt.toLocaleDateString('es-ES', { month: 'long', timeZone: 'UTC' })} ${dt.getUTCFullYear()}`;
};
const excerpt = (md = '') =>
  md.replace(/[#>*_`\-]/g, '').replace(/\s+/g, ' ').trim().slice(0, 110);

// estado del menú: fijo (elegido en el perfil) o automático (último diario)
const latestDiario = all.find((e) => e.type === 'diario');
const condition =
  profile.status && profile.status !== 'auto'
    ? profile.status
    : moodToCondition(latestDiario?.mood);

const entries = all.map((e) =>
  e.type === 'diario'
    ? {
        type: 'diario',
        title: e.title,
        date: new Date(e.date).toISOString(),
        dateLabel: fmt(e.date),
        monthLabel: monthFmt(e.date),
        summary: excerpt(e.body),
        image: diarioImage(e),
        mood: e.mood ?? '',
        moodColor: moodColor(e.mood),
        href: `/diario/${e.slug}`,
      }
    : {
        type: 'blog',
        title: e.title,
        date: new Date(e.date).toISOString(),
        dateLabel: fmt(e.date),
        monthLabel: monthFmt(e.date),
        summary: e.summary ?? excerpt(e.body),
        image: '',
        href: `/blog/${e.slug}`,
      }
);

// inventario "del momento" (placeholders por ahora)
const equip = { art: '' };
const item = { title: '', artist: '', cover: '', url: '' };
const inventory = [
  { label: 'Libro actual', sub: '(autor)', cover: '', url: '', icon: '📖' },
  { label: 'Álbum del momento', sub: '(artista)', cover: '', url: '', icon: '💿' },
  { label: 'Jugando', sub: '(juego)', cover: '', url: '', icon: '🎮' },
];
---

<Base title="0xb4d1dea">
  <PauseMenu
    client:load
    name={profile.name}
    avatar={profile.avatar}
    entries={entries}
    condition={condition}
    equip={equip}
    item={item}
    inventory={inventory}
  />
</Base>
