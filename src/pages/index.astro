---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const diario = await getCollection('diario');
const blog = await getCollection('blog');

const entries = [
  ...diario.map((e) => ({ ...e, kind: 'diario' })),
  ...blog.map((e) => ({ ...e, kind: 'blog' })),
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d) =>
  d.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: '2-digit' });
---

<Base title="0xb4d1dea — diario">
  <main>
    <header class="head">
      <h1>0xb4d1dea</h1>
      <p class="sub">diario · misceláneo · cosas diversas</p>
    </header>

    <ul class="files">
      {entries.map((e) => (
        <li>
          <a href={`/${e.kind}/${e.id}`}>
            <span class="kind">{e.kind === 'diario' ? 'ARCHIVO' : 'NOTA'}</span>
            <span class="t">{e.data.title}</span>
            <span class="d">{fmt(e.data.date)}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  main {
    max-width: 680px;
    margin: 0 auto;
    padding: clamp(40px, 9vh, 96px) 20px;
  }
  .head { margin-bottom: 40px; }
  h1 {
    margin: 0;
    font-size: 28px;
    letter-spacing: 0.18em;
    color: var(--amber);
  }
  .sub {
    margin: 8px 0 0;
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .files {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .files a {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 14px;
    align-items: baseline;
    padding: 14px 6px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }
  .files a:hover { background: #15110c; }
  .kind {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--amber);
  }
  .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .d { color: var(--muted); font-size: 12px; }
  @media (max-width: 480px) {
    .files a { grid-template-columns: 64px 1fr; }
    .d { grid-column: 2; }
  }
</style>
