---
const { title = '0xb4d1dea', fullbleed = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class={fullbleed ? 'fullbleed' : ''}>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #0c0b0a;
    --ink: #d9d2c4;
    --muted: #8c8475;
    --amber: #c89b5a;
    --line: #211d18;
    /* ancho "CRT": ligado al alto en proporción 4:3 (no crece a lo ancho) */
    --crt-w: calc(100dvh * 4 / 3);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: #000;
    color: var(--ink);
    font-family: ui-monospace, 'SF Mono', 'Courier New', monospace;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }
  body.fullbleed { overflow: hidden; }
  a { color: var(--amber); }
</style>
